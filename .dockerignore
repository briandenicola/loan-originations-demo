# The workflow image only needs src/workflow, materials, and sample-data.
# Exclude large sibling trees by LITERAL name so the ACR build context stays
# small (~few MB instead of ~800MB+). Literal directory names are honored by
# every .dockerignore implementation, unlike glob/`**` edge cases.

# Terraform modules (each carries a ~hundreds-of-MB .terraform provider cache)
infrastructure
app

# Other source trees not built into this image
src/classic
src/redteam
src/output

# Build artifacts (also prevents a stale RID-less obj/project.assets.json from
# clobbering the in-container restore -> NETSDK1047)
**/bin
**/obj
**/.terraform
**/.terraform.lock.hcl
**/.venv

# Local run output (in Azure this goes to blob storage, not the image)
output

# VCS, IDE, CI, misc
.git
.github
.assets
.gitignore
**/.vs
**/.vscode
**/.idea
**/*.user
**/*.tfstate
**/*.tfstate.*
