# Build artifacts — must be excluded so a stale, RID-less obj/project.assets.json
# from a local `dotnet build` doesn't clobber the in-container restore (NETSDK1047).
**/bin/
**/obj/

# IDE / editor
**/.vs/
**/.vscode/
**/.idea/

# Terraform state and providers
**/.terraform/
**/.terraform.lock.hcl
**/*.tfstate
**/*.tfstate.*

# VCS and misc
.git/
**/*.user
output/
